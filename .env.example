# =================================================================
# InterviewAI - Environment Configuration Template
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/interviewai

# Authentication Secret
JWT_SECRET=super_secret_jwt_key_interviewai_change_in_production
JWT_EXPIRES_IN=7d

# AI Provider Configuration (Optional - Intelligent Local Engine is active by default if not set)
# Supported providers: gemini | openai | grok (xAI) | groq | openrouter | local
# Grok: LLM_PROVIDER=grok, LLM_MODEL=grok-3-mini (any xAI model id), LLM_API_KEY=xai-...
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Optional Voice Cloud Providers (Browser Web Speech API is supported out of the box)
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_API_KEY=
